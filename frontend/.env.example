# Telegram bot username (without @)
NEXT_PUBLIC_BOT_USERNAME=your_bot_username
# Public site URL (used for OG tags and API links)
NEXT_PUBLIC_SITE_URL=https://yo-yo.dev
# $BOOMERANG contract address on Robinhood Chain (leave empty until launch)
NEXT_PUBLIC_BOOMERANG_CA=

# Server-side only
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/boomerang?sslmode=require
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Admin key for POST /api/v1/launchpads (register launchpads). Server-side only.
HOOKS_ADMIN_KEY=

# Web dashboard (server-side only)
SESSION_SECRET=
MASTER_ENCRYPTION_KEY=
INTERNAL_API_URL=http://127.0.0.1:5400
INTERNAL_API_KEY=
